<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="PalaisDefinitions" targetNamespace="https://tymultiverse.cc/bpmn">
  <bpmn:process id="PalaisAccess" name="Palais access and review" isExecutable="false">
    <bpmn:startEvent id="start" name="Application started"/>
    <bpmn:userTask id="submit" name="Maker submits (one open application per account)"/>
    <bpmn:userTask id="review" name="Checker reviews (live role check, no self-review)"/>
    <bpmn:exclusiveGateway id="outcome" name="Outcome?"/>
    <bpmn:endEvent id="withdrawn" name="Withdrawn by Maker"/>
    <bpmn:endEvent id="rejected" name="Rejected"/>
    <bpmn:exclusiveGateway id="quorum" name="Enough approvals?"/>
    <bpmn:serviceTask id="sync" name="Assign palais-checker in Keycloak (SYNCING)"/>
    <bpmn:exclusiveGateway id="result" name="Role read back?"/>
    <bpmn:serviceTask id="active" name="Access active: Palais and review rights"/>
    <bpmn:endEvent id="revoked" name="Revoked by administrator"/>
    <bpmn:serviceTask id="retry" name="Retry with backoff"/>
    <bpmn:userTask id="failedtask" name="FAILED: administrator checks and retries"/>
    <bpmn:sequenceFlow id="flow0" sourceRef="start" targetRef="submit" name=""/>
    <bpmn:sequenceFlow id="flow1" sourceRef="submit" targetRef="review" name=""/>
    <bpmn:sequenceFlow id="flow2" sourceRef="review" targetRef="outcome" name=""/>
    <bpmn:sequenceFlow id="flow3" sourceRef="outcome" targetRef="withdrawn" name="Maker withdraws"/>
    <bpmn:sequenceFlow id="flow4" sourceRef="outcome" targetRef="rejected" name="Checker rejects"/>
    <bpmn:sequenceFlow id="flow5" sourceRef="outcome" targetRef="quorum" name="Checker approves"/>
    <bpmn:sequenceFlow id="flow6" sourceRef="quorum" targetRef="review" name="More approvals needed (two-review mode)"/>
    <bpmn:sequenceFlow id="flow7" sourceRef="quorum" targetRef="sync" name="Quorum reached"/>
    <bpmn:sequenceFlow id="flow8" sourceRef="sync" targetRef="result" name=""/>
    <bpmn:sequenceFlow id="flow9" sourceRef="result" targetRef="active" name="Confirmed"/>
    <bpmn:sequenceFlow id="flow10" sourceRef="active" targetRef="revoked" name="Administrator revokes"/>
    <bpmn:sequenceFlow id="flow11" sourceRef="result" targetRef="retry" name="Temporary failure"/>
    <bpmn:sequenceFlow id="flow12" sourceRef="retry" targetRef="sync" name="Retry"/>
    <bpmn:sequenceFlow id="flow13" sourceRef="result" targetRef="failedtask" name="5 attempts exhausted"/>
    <bpmn:sequenceFlow id="flow14" sourceRef="failedtask" targetRef="sync" name="Administrator retries"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="PalaisDiagram">
    <bpmndi:BPMNPlane id="PalaisPlane" bpmnElement="PalaisAccess">
      <bpmndi:BPMNShape id="start_shape" bpmnElement="start"><dc:Bounds x="40" y="170" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="submit_shape" bpmnElement="submit"><dc:Bounds x="110" y="148" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="review_shape" bpmnElement="review"><dc:Bounds x="290" y="148" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="outcome_shape" bpmnElement="outcome"><dc:Bounds x="470" y="163" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="withdrawn_shape" bpmnElement="withdrawn"><dc:Bounds x="477" y="10" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rejected_shape" bpmnElement="rejected"><dc:Bounds x="477" y="330" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="quorum_shape" bpmnElement="quorum"><dc:Bounds x="580" y="163" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sync_shape" bpmnElement="sync"><dc:Bounds x="690" y="148" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="result_shape" bpmnElement="result"><dc:Bounds x="900" y="163" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="active_shape" bpmnElement="active"><dc:Bounds x="1010" y="148" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="revoked_shape" bpmnElement="revoked"><dc:Bounds x="1220" y="170" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="retry_shape" bpmnElement="retry"><dc:Bounds x="850" y="300" width="150" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="failedtask_shape" bpmnElement="failedtask"><dc:Bounds x="850" y="20" width="150" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow0_edge" bpmnElement="flow0">
        <di:waypoint x="76" y="188"/>
        <di:waypoint x="110" y="188"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow1_edge" bpmnElement="flow1">
        <di:waypoint x="250" y="188"/>
        <di:waypoint x="290" y="188"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow2_edge" bpmnElement="flow2">
        <di:waypoint x="440" y="188"/>
        <di:waypoint x="470" y="188"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow3_edge" bpmnElement="flow3">
        <di:waypoint x="495" y="163"/>
        <di:waypoint x="495" y="46"/>
      <bpmndi:BPMNLabel><dc:Bounds x="505" y="95" width="110" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow4_edge" bpmnElement="flow4">
        <di:waypoint x="495" y="213"/>
        <di:waypoint x="495" y="330"/>
      <bpmndi:BPMNLabel><dc:Bounds x="505" y="262" width="100" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow5_edge" bpmnElement="flow5">
        <di:waypoint x="520" y="188"/>
        <di:waypoint x="580" y="188"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow6_edge" bpmnElement="flow6">
        <di:waypoint x="605" y="213"/>
        <di:waypoint x="605" y="430"/>
        <di:waypoint x="365" y="430"/>
        <di:waypoint x="365" y="228"/>
      <bpmndi:BPMNLabel><dc:Bounds x="380" y="436" width="240" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow7_edge" bpmnElement="flow7">
        <di:waypoint x="630" y="188"/>
        <di:waypoint x="690" y="188"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow8_edge" bpmnElement="flow8">
        <di:waypoint x="840" y="188"/>
        <di:waypoint x="900" y="188"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow9_edge" bpmnElement="flow9">
        <di:waypoint x="950" y="188"/>
        <di:waypoint x="1010" y="188"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow10_edge" bpmnElement="flow10">
        <di:waypoint x="1160" y="188"/>
        <di:waypoint x="1220" y="188"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow11_edge" bpmnElement="flow11">
        <di:waypoint x="925" y="213"/>
        <di:waypoint x="925" y="300"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow12_edge" bpmnElement="flow12">
        <di:waypoint x="850" y="335"/>
        <di:waypoint x="765" y="335"/>
        <di:waypoint x="765" y="228"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow13_edge" bpmnElement="flow13">
        <di:waypoint x="925" y="163"/>
        <di:waypoint x="925" y="90"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow14_edge" bpmnElement="flow14">
        <di:waypoint x="850" y="55"/>
        <di:waypoint x="765" y="55"/>
        <di:waypoint x="765" y="148"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
