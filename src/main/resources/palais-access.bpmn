<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="PalaisDefinitions" targetNamespace="https://tymultiverse.cc/bpmn">
  <bpmn:process id="PalaisAccess" name="Palais access and review" isExecutable="false">
    <bpmn:startEvent id="start" name="Application started"/>
    <bpmn:userTask id="submit" name="Maker submits"/>
    <bpmn:exclusiveGateway id="decision" name="Checker decision"/>
    <bpmn:userTask id="reject" name="Reject or withdraw"/>
    <bpmn:exclusiveGateway id="quorum" name="Quorum reached?"/>
    <bpmn:userTask id="second" name="Await another Checker"/>
    <bpmn:serviceTask id="sync" name="Assign and verify Keycloak role"/>
    <bpmn:exclusiveGateway id="result" name="Role confirmed?"/>
    <bpmn:serviceTask id="retry" name="Retry with backoff"/>
    <bpmn:endEvent id="failed" name="Sync failed"/>
    <bpmn:endEvent id="active" name="Palais access active"/>
    <bpmn:endEvent id="closed" name="Application closed"/>
    <bpmn:sequenceFlow id="flow0" sourceRef="start" targetRef="submit" name=""/>
    <bpmn:sequenceFlow id="flow1" sourceRef="submit" targetRef="decision" name=""/>
    <bpmn:sequenceFlow id="flow2" sourceRef="decision" targetRef="reject" name="Reject / withdraw"/>
    <bpmn:sequenceFlow id="flow3" sourceRef="reject" targetRef="closed" name=""/>
    <bpmn:sequenceFlow id="flow4" sourceRef="decision" targetRef="quorum" name="Approve"/>
    <bpmn:sequenceFlow id="flow5" sourceRef="quorum" targetRef="second" name="More approvals needed"/>
    <bpmn:sequenceFlow id="flow6" sourceRef="second" targetRef="decision" name=""/>
    <bpmn:sequenceFlow id="flow7" sourceRef="quorum" targetRef="sync" name="Complete"/>
    <bpmn:sequenceFlow id="flow8" sourceRef="sync" targetRef="result" name=""/>
    <bpmn:sequenceFlow id="flow9" sourceRef="result" targetRef="retry" name="Retryable failure"/>
    <bpmn:sequenceFlow id="flow10" sourceRef="retry" targetRef="sync" name="Retry"/>
    <bpmn:sequenceFlow id="flow11" sourceRef="result" targetRef="failed" name="Attempts exhausted"/>
    <bpmn:sequenceFlow id="flow12" sourceRef="result" targetRef="active" name="Confirmed"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="PalaisDiagram">
    <bpmndi:BPMNPlane id="PalaisPlane" bpmnElement="PalaisAccess">
      <bpmndi:BPMNShape id="start_shape" bpmnElement="start"><dc:Bounds x="70" y="145" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="submit_shape" bpmnElement="submit"><dc:Bounds x="140" y="125" width="120" height="76"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="decision_shape" bpmnElement="decision"><dc:Bounds x="310" y="138" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reject_shape" bpmnElement="reject"><dc:Bounds x="420" y="20" width="150" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="quorum_shape" bpmnElement="quorum"><dc:Bounds x="450" y="138" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="second_shape" bpmnElement="second"><dc:Bounds x="405" y="265" width="140" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sync_shape" bpmnElement="sync"><dc:Bounds x="570" y="125" width="160" height="76"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="result_shape" bpmnElement="result"><dc:Bounds x="775" y="138" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="retry_shape" bpmnElement="retry"><dc:Bounds x="600" y="265" width="140" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="failed_shape" bpmnElement="failed"><dc:Bounds x="810" y="282" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="active_shape" bpmnElement="active"><dc:Bounds x="910" y="145" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="closed_shape" bpmnElement="closed"><dc:Bounds x="640" y="38" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow0_edge" bpmnElement="flow0">
        <di:waypoint x="106" y="163"/>
        <di:waypoint x="140" y="163"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow1_edge" bpmnElement="flow1">
        <di:waypoint x="260" y="163"/>
        <di:waypoint x="310" y="163"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow2_edge" bpmnElement="flow2">
        <di:waypoint x="335" y="138"/>
        <di:waypoint x="335" y="55"/>
        <di:waypoint x="420" y="55"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow3_edge" bpmnElement="flow3">
        <di:waypoint x="570" y="55"/>
        <di:waypoint x="640" y="55"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow4_edge" bpmnElement="flow4">
        <di:waypoint x="360" y="163"/>
        <di:waypoint x="450" y="163"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow5_edge" bpmnElement="flow5">
        <di:waypoint x="475" y="188"/>
        <di:waypoint x="475" y="265"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow6_edge" bpmnElement="flow6">
        <di:waypoint x="405" y="300"/>
        <di:waypoint x="335" y="300"/>
        <di:waypoint x="335" y="188"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow7_edge" bpmnElement="flow7">
        <di:waypoint x="500" y="163"/>
        <di:waypoint x="570" y="163"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow8_edge" bpmnElement="flow8">
        <di:waypoint x="730" y="163"/>
        <di:waypoint x="775" y="163"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow9_edge" bpmnElement="flow9">
        <di:waypoint x="800" y="188"/>
        <di:waypoint x="800" y="240"/>
        <di:waypoint x="670" y="240"/>
        <di:waypoint x="670" y="265"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow10_edge" bpmnElement="flow10">
        <di:waypoint x="600" y="300"/>
        <di:waypoint x="580" y="300"/>
        <di:waypoint x="580" y="201"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow11_edge" bpmnElement="flow11">
        <di:waypoint x="812" y="177"/>
        <di:waypoint x="828" y="215"/>
        <di:waypoint x="828" y="282"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow12_edge" bpmnElement="flow12">
        <di:waypoint x="825" y="163"/>
        <di:waypoint x="910" y="163"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
